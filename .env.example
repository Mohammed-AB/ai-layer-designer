# ── Supabase (client-side) ─────────────────────────────────────────────
# Safe to expose in the browser (anon/publishable scope).
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Server-side (DO NOT put here) ──────────────────────────────────────
# Set as a Supabase Edge Function secret, not in this file:
#   LOVABLE_API_KEY   used by the `generate-layers` function to call the
#                     image-generation gateway (Gemini 2.5 Flash).
#   supabase secrets set LOVABLE_API_KEY=...
