# ── Supabase (client-side) ─────────────────────────────────────────────
# Safe to expose in the browser (anon/publishable scope).
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Server-side (DO NOT put here) ──────────────────────────────────────
# Set as Supabase Edge Function secrets, not in this file:
#   AI_GATEWAY_API_KEY  used by the `generate-layers` function to authenticate
#                       against an OpenAI-compatible image-generation gateway
#                       (Gemini 2.5 Flash image).
#   AI_GATEWAY_URL      the gateway's chat-completions endpoint.
#   supabase secrets set AI_GATEWAY_API_KEY=...
#   supabase secrets set AI_GATEWAY_URL=...
AI_GATEWAY_API_KEY="YOUR_GATEWAY_API_KEY"
AI_GATEWAY_URL="https://your-openai-compatible-image-endpoint/v1/chat/completions"
